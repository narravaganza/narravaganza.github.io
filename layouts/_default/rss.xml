{{- $pages := where .RegularPages "Params.listincollection" "!=" false -}}
{{- $pages = where $pages "Draft" false -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}{{- $pages = first $limit $pages -}}{{- end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} on {{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content in {{ .Title }} on {{ .Site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ .Site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
{{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ partial "optimized-images.html" (dict "content" .Summary "absolute" true) | transform.XMLEscape | safeHTML }}</description>
    </item>
{{ end }}
  </channel>
</rss>
